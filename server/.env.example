# ── Serveur ────────────────────────────────────────────────
# Sous-domaine public qui pointe vers le VPS (sans https://)
PUBLIC_HOST=voice.example.com
# Secret pour signer les flux audio : génère-le avec  openssl rand -hex 32
STREAM_SECRET=
PORT=8765
# Durée max d'un appel (garde-fou coûts)
MAX_CALL_SECONDS=600
VERIFY_TWILIO_SIGNATURE=true

# ── Twilio (numéro + transfert d'appel) ───────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Voix ───────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
CARTESIA_API_KEY=
# Voix par défaut si le garage n'en définit pas (voix française de la librairie Cartesia)
CARTESIA_VOICE_ID=

# ── LLM ────────────────────────────────────────────────────
# mistral (défaut, le moins cher) | google (Gemini) | anthropic | openai (tout fournisseur compatible OpenAI)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── n8n ────────────────────────────────────────────────────
# Vide = agenda MOCK en fichier local (pratique pour les premiers tests)
# Sur le même réseau Docker que n8n, passer en interne (plus rapide, pas de HTTPS) :
#   N8N_WEBHOOK_BASE=http://n8n:5678/webhook
N8N_WEBHOOK_BASE=
# Même valeur que le credential "Header Auth" (X-Voice-Secret) dans n8n
N8N_WEBHOOK_SECRET=
# Adresse qui reçoit les mails "nouveau RDV", messages et rapports d'appel
NOTIFY_EMAIL=

# ── Appel depuis le navigateur (page /appel, sans numéro de téléphone) ──
# Code à mettre dans le lien : https://PUBLIC_HOST/appel?code=XXXX  (vide = page désactivée)
WEB_CALL_CODE=
MAX_WEB_CALLS=2

# Garage utilisé par `python bot.py -t eval` et par la page /appel

DEFAULT_TENANT=garage-demo
